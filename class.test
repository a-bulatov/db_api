CREATE OR REPLACE FUNCTION demo.class_list_get(f_params jsonb DEFAULT NULL::jsonb)
 RETURNS jsonb
 LANGUAGE plpgsql
AS $function$
begin
 return
    (
	 select array_to_json(array_agg(
        jsonb_build_object(
             'guid',x.guid,
             'data', jsonb_build_object(
                  'title', x.title
             )
        )
    ))::jsonb from (
        select
          c.guid,
	      c.title
        from meta.class c
    ) x
	);
end
$function$

